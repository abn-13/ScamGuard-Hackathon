<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS module: on-device permission, requested again at runtime. Only READ_SMS now:
         RECEIVE_SMS was for live broadcast capture, since dropped. Confirmed via testing
         that SMS_RECEIVED is delivered exclusively to the default SMS app on this
         platform, never to a third-party receiver, so SMS monitoring is poll-based
         (PollSmsWorker) like email, not broadcast-driven. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Also SMS module: computes is_known_sender by looking up the sender in Contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Email module: Gmail API calls over the network via OAuth, not a device permission -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Runtime-requested on API 33+ (see MainActivity) so RiskNotifier can show a system
         notification for medium/high risk messages. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScamGuardSpike">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ScamGuardSpike">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".registration.RegistrationActivity"
            android:exported="false"
            android:label="@string/registration_screen_title"
            android:theme="@style/Theme.ScamGuardSpike" />

        <activity
            android:name=".sms.SmsListActivity"
            android:exported="false"
            android:label="@string/sms_screen_title"
            android:theme="@style/Theme.ScamGuardSpike" />

        <activity
            android:name=".email.EmailListActivity"
            android:exported="false"
            android:label="@string/email_screen_title"
            android:theme="@style/Theme.ScamGuardSpike" />
    </application>

</manifest>

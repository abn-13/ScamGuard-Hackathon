# AWS Bedrock -- see the "AWS Bedrock Setup" doc shared with the team.
# If you're using `aws login` (recommended for local dev, already set up on the
# team AWS account) leave these two blank -- boto3 picks up the login session
# automatically. Only fill them in if you're using a static IAM access key instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Confirmed working on this account as of 2026-09-06 -- use as-is, or swap for
# another model if you have access to it. IMPORTANT: a model showing up in
# `aws bedrock list-foundation-models` or `list-inference-profiles` does NOT
# mean your account has access to it -- that's a separate grant. Test with a
# real call (see backend/README.md Task 5) before assuming a different ID works.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Google Safe Browsing -- Cloud Console -> APIs & Services -> Library -> enable "Safe Browsing API"
# -> Credentials -> Create API key
SAFE_BROWSING_API_KEY=

# Optional Task 3b enrichment. When configured, the Agent can search for
# candidate official domains for brands that are not in the local registry.
# Search results remain unverified evidence and are never auto-allowlisted.
BRAVE_SEARCH_API_KEY=

# Optional outbound DNS/RDAP/Certificate Transparency checks. Disabled by
# default so a self-hosted deployment does not send domain queries externally
# until the operator explicitly opts in.
DOMAIN_INTELLIGENCE_ENABLED=false

# Optional higher Cert Spotter rate limits for Task 3b domain intelligence.
# Evaluation requests can run without a token; production use should configure one.
CERTSPOTTER_API_TOKEN=

# Telegram bot for family alerts -- create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# The bot's @username (no leading @, e.g. "ScamGuardAlertBot"), also from BotFather.
# Optional: only used to build a tappable https://t.me/<username>?start=<code> deep link
# for the app to show a family member during linking. Without it, the app shows the raw
# code and the family member sends it to the bot manually instead.
TELEGRAM_BOT_USERNAME=

# Local dev database (SQLite file, created automatically on first run)
DATABASE_URL=sqlite:///./scamguard.db
